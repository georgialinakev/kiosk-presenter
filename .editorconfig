root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,manifest}]
indent_size = 2

[*.{js,css,html}]
indent_size = 2

[*.sln]
end_of_line = crlf
indent_style = tab

[ui/**]
# Claude Design output: keep as exported apart from the HOST: edits.
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
