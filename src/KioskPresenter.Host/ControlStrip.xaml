<Window x:Class="KioskPresenter.Host.ControlStrip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiosk controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <!-- Values from ui/tokens.css: strip-bg, strip-border, strip-icon, strip-pressed. -->
    <Window.Resources>
        <SolidColorBrush x:Key="StripBg" Color="#DB0E0F1A" />
        <SolidColorBrush x:Key="StripBorder" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="StripIcon" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="StripPressed" Color="#38FFFFFF" />

        <Style x:Key="StripButton" TargetType="Button">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource StripIcon}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Ellipse x:Name="Press" Fill="{StaticResource StripPressed}" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Press" Property="Opacity" Value="1" />
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource StripIcon}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>

    <Border x:Name="Pill"
            Background="{StaticResource StripBg}"
            BorderBrush="{StaticResource StripBorder}"
            BorderThickness="1"
            CornerRadius="44"
            Height="88"
            Padding="12"
            Margin="0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="HomeButton" Style="{StaticResource StripButton}" AutomationProperties.Name="All presentations" Click="Home_Click">
                <Viewbox Width="32" Height="32">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource Icon}" Data="M3,10.5 L12,3 L21,10.5 M5,9 L5,20 L19,20 L19,9 M10,20 L10,14 L14,14 L14,20" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Rectangle Width="1" Height="40" Margin="16,0" Fill="{StaticResource StripBorder}" />
            <Button x:Name="PrevButton" Style="{StaticResource StripButton}" AutomationProperties.Name="Previous slide" Click="Prev_Click">
                <Viewbox Width="36" Height="36">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource Icon}" Data="M15,5 L8,12 L15,19" />
                    </Canvas>
                </Viewbox>
            </Button>
            <TextBlock x:Name="Counter"
                       Text="1 / 1"
                       MinWidth="104"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="24"
                       FontWeight="Bold"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{StaticResource StripIcon}" />
            <Button x:Name="NextButton" Style="{StaticResource StripButton}" AutomationProperties.Name="Next slide" Click="Next_Click">
                <Viewbox Width="36" Height="36">
                    <Canvas Width="24" Height="24">
                        <Path Style="{StaticResource Icon}" Data="M9,5 L16,12 L9,19" />
                    </Canvas>
                </Viewbox>
            </Button>
        </StackPanel>
    </Border>
</Window>
