<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the Windows-only projects build on any OS (CI still runs on windows-latest). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.1.0</Version>
    <Company>Georgialina Networks</Company>
    <Product>Kiosk Presenter</Product>
    <Copyright>Georgialina Networks</Copyright>
    <!-- Warnings stay warnings for the MVP; flip this on once the first builds are clean. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
